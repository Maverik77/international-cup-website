# Testing
coverage/
.nyc_output/

# Local development
*.local

# Backup files
*.bak
*.backup 
# SAM build artifacts
.aws-sam/
lambda/*/fn.zip

# Local contact lists - public repo, these must not be committed
contacts/

# Party card videos - large local build artefacts, never deployed
party/cards/
party/veo/

# The slideshow of past tournaments, built by party/build/build-photos.mjs from
# folders that are not in this repository. Other people's faces at private
# parties: they stay on the laptop, and nobody consented to a public repo.
party/photos/

# Party show manifest and live state - built from contacts/, must never be published
# Patterns, not exact names: atomic writes leave <name>.tmp and corrupt state is
# moved aside to <name>.corrupt-<timestamp>; each holds the same private data.
party/show.json*
party/state.json*
party/state.rehearsal.json*

# The operator console's password: a secret, generated on first boot
party/operator-password.txt

# The running record of the party build. It quotes hometowns and consent
# decisions for players who said no to the website - Tom Walsh's town, Rhys
# Gully's - so it belongs with contacts/, not in a public repo.
party/RESUME.md

# Git worktrees for isolated feature work
.worktrees/

# The party hub is source code, not a build artefact. The build/ and public/
# patterns near the top of this file are unanchored boilerplate (the latter
# from a Gatsby template) and match at any depth, so without these negations
# party/build/ and party/public/ would be silently untrackable.
!party/build/
!party/public/
.superpowers/

# Player films: ~600 MB, hosted in S3 under films/, never committed.
films/
